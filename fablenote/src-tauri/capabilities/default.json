{
  "$schema": "https://schema.tauri.app/config/2",
  "identifier": "default",
  "description": "Default capability for NATIA",
  "local": true,
  "windows": ["main"],
  "permissions": [
    "core:default",
    "dialog:allow-save",
    "dialog:allow-open",
    "notification:default",
    {
      "identifier": "opener:allow-open-url",
      "allow": [
        { "url": "https://github.com/Buntasam/NATIA" },
        { "url": "https://github.com/Buntasam/NATIA/issues" },
        { "url": "https://github.com/Buntasam/NATIA/discussions" }
      ]
    }
  ]
}
